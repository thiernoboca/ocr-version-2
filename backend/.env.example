# Application
APP_NAME="OCR Document System"
APP_ENV=development
APP_DEBUG=true
APP_URL=http://localhost:8080

# Dynamsoft License
DYNAMSOFT_LICENSE=YOUR_DYNAMSOFT_LICENSE_KEY_HERE

# Database
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=ocr_documents
DB_USERNAME=ocr_user
DB_PASSWORD=ocr_password

# Security
ENCRYPTION_KEY=change_this_to_32_character_random_string_minimum
JWT_SECRET=change_this_to_your_secret_jwt_key
JWT_EXPIRATION=3600

# File Upload
MAX_UPLOAD_SIZE=10485760
ALLOWED_FILE_TYPES=jpg,jpeg,png,pdf,tiff
UPLOAD_PATH=storage/app/documents

# OCR Configuration
TESSERACT_PATH=/usr/bin/tesseract
TESSERACT_LANGUAGES=fra+eng
TESSERACT_PSM=3
OCR_CONFIDENCE_THRESHOLD=0.7

# PassportEye (Python)
PYTHON_PATH=/usr/bin/python3
PASSPORTEYE_SCRIPT_PATH=scripts/passport_ocr.py

# OCR Cache Configuration
OCR_CACHE_ENABLED=true
OCR_CACHE_DIR=storage/cache/ocr
OCR_CACHE_TTL=3600

# Auto-Rotation Configuration
AUTO_ROTATION_ENABLED=true
AUTO_ROTATION_CONFIDENCE_THRESHOLD=1.5

# GDPR & Data Retention
DOCUMENT_RETENTION_DAYS=30
AUTO_DELETE_ENABLED=true
AUDIT_LOG_ENABLED=true

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
CORS_ALLOWED_METHODS=GET,POST,PUT,DELETE,OPTIONS
CORS_ALLOWED_HEADERS=Content-Type,Authorization,X-Requested-With

# Rate Limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_WINDOW_MINUTES=15

# Logging
LOG_LEVEL=debug
LOG_PATH=storage/logs/app.log

# Configuration Frontend

# URL de l'API backend
VITE_API_URL=http://localhost:8080/api

# Clé de licence Dynamsoft (obtenez-la sur https://www.dynamsoft.com/customer/license/trialLicense)
VITE_DYNAMSOFT_LICENSE=YOUR_LICENSE_KEY_HERE

# Configuration de l'application
VITE_APP_NAME="OCR Document System"
VITE_APP_VERSION=2.0.0

# Taille maximale de fichier (en bytes)
VITE_MAX_FILE_SIZE=10485760

# Types de fichiers autorisés
VITE_ALLOWED_FILE_TYPES=image/jpeg,image/png,image/tiff,application/pdf
